# HTTP 전용. HTTPS는 앞단 리버스 프록시(NPM 등)가 처리한다.
# 백엔드는 Origin이 APP_FRONTEND_ORIGIN과 같은지 검사하므로 Origin 헤더는 그대로 넘긴다(reverse_proxy 기본 동작).
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# createBrowserRouter 경로는 모두 index.html로 돌려준다.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
